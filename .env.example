# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Flow Chile
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_API_URL=https://sandbox.flow.cl/api

# Meta Pixel
NEXT_PUBLIC_META_PIXEL_ID=

# App — URL pública (Flow urlReturn / webhook, emails, metadata)
# Producción: https://tudominio.cl (sin barra final). Vercel: Project → Settings → Environment Variables.
# Si no está definida, en servidor se usa SITE_URL o https://VERCEL_URL (host del deploy actual).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# SITE_URL=https://tudominio.cl   # opcional; mismo uso que NEXT_PUBLIC_SITE_URL (solo servidor)
NEXT_PUBLIC_SITE_NAME=TheGate

# Email (Resend)
RESEND_API_KEY=
STORE_CONTACT_EMAIL=
STORE_FROM_EMAIL=

# Admin
# Legacy fallback (temporal)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Sesiones propias (bcrypt + cookie HMAC-SHA256). Obligatorias — sin fallback.
# Genera cada una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
CUENTA_SESSION_SECRET=

# Cron (protege /api/cron/cancel-stale-orders contra invocación pública)
CRON_SECRET=

# Cloudflare R2 (almacenamiento de imágenes, API compatible con S3).
# Privadas — nunca uses el prefijo NEXT_PUBLIC_* para estas 4. Ver R2_SETUP.md
# para cómo crear el bucket y un token de acceso limitado a este bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Pública a propósito: es la URL base desde la que se sirven las imágenes
# (dominio propio recomendado en producción; *.r2.dev sirve para desarrollo).
R2_PUBLIC_URL=
